#!ipxe

# Custom Ubuntu Operating System
# https://www.ubuntu.com

:custom
set port :31011

echo Chris' Custom Menus
echo Hostname.... ${hostname}
echo Product..... ${product}
echo CPU Vendor.. ${cpuvendor}
echo Platform.... ${platform}
echo Architecture ${arch}
echo Next Server. ${next-server}
echo DHCP Server. ${dhcp-server}

clear target
iseq ${product} NVIDIA_DGX_Spark && set target spark
isset ${target} && echo Found target ${target} ||

prompt --timeout 5000 Press any key ||
isset ${target} && goto ${target}_menu
exit


# Rescue
# set install_params systemd.unit=rescue.target ||
# Autoinstall
# set install_params autoinstall ds=nocloud-net;s=${install_url} ||

## DGX Spark

:spark_menu
menu DGX Spark
item --gap Ubuntu 26.04
item spark_ubuntu_26041_64k 64K Pages
item spark_ubuntu_26041_4k  4K Pages
choose --default spark_ubuntu_26041_64k --timeout 5000 target || goto custom_exit
goto ${target}

:spark_ubuntu_26041_64k
set version_number 26.04.1
set suffix +largemem
set codename resolute
goto spark_ubuntu

:spark_ubuntu_26041_4k
set version_number 26.04.1
clear suffix
set codename resolute
goto spark_ubuntu

:spark_ubuntu
set kernel_url https://github.com/czankel/ubuntu-largemem/releases/download/26.04.1-latest/
# console=ttyS0,921600
set kernel_params console=tty0 sbsa_gwdt.action=1
set netboot_params ip=dhcp autoinstall ds=nocloud;s=http://${next-server}${port}/autoinstall/${product}/
goto ubuntu_boot

## Ubuntu

:ubuntu_boot
imgfree
set os Ubuntu
set os_arch ${arch}
iseq ${os_arch} x86_64 && set os_arch amd64 ||

iseq ${os_arch} amd64 && set ubuntu_iso_url http://releases.ubuntu.com/${codename}/ubuntu-${version_number}-live-server-${os_arch}.iso ||
iseq ${os_arch} arm64 && set ubuntu_iso_url http://cdimage.ubuntu.com/releases/${version_number}/release/ubuntu-${version_number}-live-server-${os_arch}${suffix}.iso ||

set cmdline ramdisk_size=3500000 ${kernel_params} url=${ubuntu_iso_url} ${netboot_params} ${install_params} initrd=initrd.magic

echo Loading kernel and initrd
kernel ${kernel_url}vmlinuz ${cmdline}
initrd ${kernel_url}initrd
echo
echo Booting ${kernel} ${cmdline}

echo
echo MD5sums:
md5sum vmlinuz initrd

prompt --timeout 5000 --key x Press 'x' to exit && exit ||
boot

:custom_exit
clear menu
exit 0

